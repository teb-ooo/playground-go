<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{.Title}}</title>
<style>
  :root { color-scheme: light dark; supported-color-schemes: light dark; }
  @media (prefers-color-scheme: dark) {
    .bg-ground { background-color: #0b0d12 !important; }
    .bg-surface { background-color: #15181e !important; border-color: #2f333a !important; }
    .ink { color: #eceff2 !important; }
    .muted { color: #9fa5ae !important; }
    .rule { border-color: #2f333a !important; }
  }
</style>
</head>
<body class="bg-ground" style="margin:0;padding:0;background-color:#f9fafc;color:#11161f;">
<!-- Preheader: inbox preview text, hidden in the body. -->
<div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">{{.Preheader}}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="bg-ground" style="background-color:#f9fafc;">
  <tr>
    <td align="center" style="padding:32px 16px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;width:100%;">
        <tr>
          <td style="padding:0 0 24px 0;">
            <!-- LOGO SLOT: the factory logo, as a data URI <img>, replaces the wordmark below. -->
            <span class="ink" style="font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;font-size:18px;line-height:28px;font-weight:600;color:#11161f;letter-spacing:-0.01em;">{{.FactoryName}}</span>
          </td>
        </tr>
        <tr>
          <td class="bg-surface" style="background-color:#eef0f4;border:1px solid #d4d8dd;border-radius:4px;padding:32px 28px;">
            <h1 class="ink" style="margin:0 0 20px 0;font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;font-size:24px;line-height:32px;font-weight:600;color:#11161f;">{{.Title}}</h1>
            <div class="ink" style="font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;font-size:14px;line-height:22px;color:#11161f;">
{{template "content" .}}
            </div>
          </td>
        </tr>
        <tr>
          <td class="rule" style="padding:24px 0 0 0;">
            <p class="muted" style="margin:0;font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;font-size:12px;line-height:20px;color:#545b66;">{{.Footer}}</p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
