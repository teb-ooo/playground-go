<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{.Title}}</title>
<style>
  :root { color-scheme: light dark; supported-color-schemes: light dark; }
  @media (prefers-color-scheme: dark) {
    .bg-ground { background-color: #000000 !important; }
    .bg-surface { background-color: #141414 !important; border-color: #2e2e2e !important; }
    .ink { color: #ffffff !important; }
    .muted { color: #b7b7b7 !important; }
  }
</style>
</head>
<body class="bg-ground" style="margin:0;padding:0;background-color:#ffffff;color:#000000;">
<!-- Preheader: inbox preview text, hidden in the body. -->
<div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">{{.Preheader}}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="bg-ground" style="background-color:#ffffff;">
  <tr>
    <td align="center" style="padding:32px 16px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;width:100%;">
        <tr>
          <td style="padding:0 0 24px 0;">
            <!-- LOGO SLOT: the factory logo, as a data URI <img>, replaces the wordmark below. -->
            <span class="ink" style="font-family:'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;font-size:14px;line-height:1.6;color:#000000;">{{.FactoryName}}</span>
          </td>
        </tr>
        <tr>
          <td class="bg-surface" style="background-color:#f3f3f3;border:1px solid #dedede;border-radius:4px;padding:32px 28px;">
            <h1 class="ink" style="margin:0 0 20px 0;font-family:'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;font-size:32px;line-height:1.3;font-weight:400;color:#000000;">{{.Title}}</h1>
            <div class="ink" style="font-family:'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;font-size:14px;line-height:1.6;color:#000000;">
{{template "content" .}}
            </div>
          </td>
        </tr>
        <tr>
          <td style="padding:24px 0 0 0;">
            <p class="muted" style="margin:0;font-family:'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;font-size:14px;line-height:1.6;color:#4d4d4d;">{{.Footer}}</p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
